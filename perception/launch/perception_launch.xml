<launch>
    <arg name="param_file" description="Filepath to the opponent tracking/detection config file" />
    <!-- <arg name="map_name" default="hangar_1905_v0" description="Map folder in stack_master/maps" /> -->
    <arg name="map_name" default="latest" description="Map folder in stack_master/maps" />
    <arg name="detector_exec" default="detect" description="detect (C++) or detect_python (legacy)" />
    <arg name="measure" default="false" description="Publish detector/tracker latency measurements" />
    <arg name="sim" default="False" description="True/False if running in simulation" />

    <!-- Two declarations of the detector rather than one node with a conditional
         <param>: the XML launch <param> tag does not accept an `if` attribute, so
         the condition has to sit on an enclosing <group>. The real-car branch
         (sim:=False, the default) is byte-for-byte the original node. -->

    <group if="$(var sim)">
        <node pkg="perception" name="detect" exec="$(var detector_exec)" output="log"
            args="--ros-args --log-level info">
            <param from= "$(var param_file)" />
            <!-- Simulation-only overrides, layered over the shared config above. -->
            <param from= "$(find-pkg-share stack_master)/config/SIM/sim_perception_overrides.yaml" />
            <param name="map_name" value="$(var map_name)" />
            <param name="measure" value="$(var measure)" />
        </node>
    </group>

    <group unless="$(var sim)">
        <node pkg="perception" name="detect" exec="$(var detector_exec)" output="log"
            args="--ros-args --log-level info">
            <param from= "$(var param_file)" />
            <param name="map_name" value="$(var map_name)" />
            <param name="measure" value="$(var measure)" />
            <!-- tuning lives in the param_file yaml (opponent_tracker_params.yaml); FQN fixed so it applies now -->
            <!-- <param name="filter_kernel_size" value="11" /> -->
            <!-- <param name="max_obs_size" value="0.5" /> -->
            <!-- <param name="min_obs_size" value="10" /> -->
        </node>
    </group>

    <!-- Same two-declaration shape as the detector above, and for the same reason:
         <param> takes no `if`, so the sim-only override file needs an enclosing
         <group>. The real-car branch (sim:=False, the default) is unchanged. -->

    <group if="$(var sim)">
        <node pkg="perception" name="tracking" exec="tracking" output="log"
            args="--ros-args --log-level warn">
            <param from= "$(var param_file)" />
            <!-- Simulation-only overrides, layered over the shared config above. -->
            <param from= "$(find-pkg-share stack_master)/config/SIM/sim_perception_overrides.yaml" />
            <param name="measure" value="$(var measure)" />
        </node>
    </group>

    <group unless="$(var sim)">
        <node pkg="perception" name="tracking" exec="tracking" output="log"
            args="--ros-args --log-level warn">
            <param from= "$(var param_file)" />
            <param name="measure" value="$(var measure)" />
        </node>
    </group>
</launch>
